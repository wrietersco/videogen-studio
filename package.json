{
  "name": "videogen-studio",
  "version": "0.1.0",
  "description": "Dynamic, editable AI video generator — prompt in, platform-ready video out",
  "main": "out/main/index.js",
  "type": "module",
  "author": "VideoGen Studio",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run tests/unit.test.ts tests/compose.test.ts tests/director.test.ts",
    "test:e2e": "vitest run tests/pipeline.test.ts",
    "gen": "tsx scripts/gen.ts",
    "verify": "npm run typecheck && npm run test",
    "setup-vendor": "node scripts/setup-vendor.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@huggingface/transformers": "^3.7.6",
    "@hyperframes/core": "^0.8.204",
    "@hyperframes/producer": "^0.8.204",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "gsap": "^3.13.0",
    "sharp": "^0.34.5",
    "three": "^0.180.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-vite": "^4.0.0",
    "hyperframes": "^0.8.204",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
